{
  "id": "blog_post",
  "label": "Blog Post",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL Slug",
          "placeholder": "my-blog-post"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": "Enter blog post title"
        }
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Featured Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "excerpt": {
        "type": "Text",
        "config": {
          "label": "Excerpt",
          "placeholder": "Short description for blog cards"
        }
      },
      "category": {
        "type": "Text",
        "config": {
          "label": "Category",
          "placeholder": "e.g., Technology, Construction, News"
        }
      },
      "author": {
        "type": "Text",
        "config": {
          "label": "Author Name",
          "placeholder": "Enter author name"
        }
      },
      "publication_date": {
        "type": "Date",
        "config": {
          "label": "Publication Date"
        }
      },
      "reading_time": {
        "type": "Text",
        "config": {
          "label": "Reading Time",
          "placeholder": "e.g., 5 min read"
        }
      },
      "content": {
        "type": "StructuredText",
        "config": {
          "label": "Content",
          "placeholder": "Write your blog content here...",
          "allowTargetBlank": true,
          "multi": "paragraph,preformatted,heading2,heading3,heading4,strong,em,hyperlink,image,embed,list-item,o-list-item"
        }
      }
    },
    "SEO": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "SEO title (optional)"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "SEO description (optional)"
        }
      }
    }
  },
  "format": "custom"
}
