{
  "id": "use_case_cards",
  "type": "SharedSlice",
  "name": "UseCaseCards",
  "description": "Three-card use case showcase with interactive selection",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Three use case cards in horizontal layout",
      "imageUrl": "",
      "primary": {
        "section_title": {
          "type": "Text",
          "config": {
            "label": "Section Title",
            "placeholder": "Use cases"
          }
        },
        "steps": {
          "type": "Group",
          "config": {
            "label": "Steps (for all cards)",
            "fields": {
              "card_id": {
                "type": "Text",
                "config": {
                  "label": "Card ID (must match card's ID)",
                  "placeholder": "e.g., accessibility"
                }
              },
              "step_title": {
                "type": "Text",
                "config": {
                  "label": "Step Title",
                  "placeholder": "Step 1 — Configuration"
                }
              },
              "step_description": {
                "type": "StructuredText",
                "config": {
                  "label": "Step Description",
                  "multi": "paragraph,list-item",
                  "allowTargetBlank": false
                }
              },
              "step_image": {
                "type": "Image",
                "config": {
                  "label": "Step Image (single image)",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "use_composition": {
                "type": "Boolean",
                "config": {
                  "label": "Use Image Composition",
                  "default_value": false,
                  "placeholder_false": "Single Image",
                  "placeholder_true": "Composition (3 images)"
                }
              },
              "use_lottie": {
                "type": "Boolean",
                "config": {
                  "label": "Use Lottie Animation",
                  "default_value": false,
                  "placeholder_false": "Static",
                  "placeholder_true": "Animated"
                }
              },
              "lottie_url": {
                "type": "Text",
                "config": {
                  "label": "Lottie Animation URL",
                  "placeholder": "/animations/step1-config.json"
                }
              },
              "composition_main_image": {
                "type": "Image",
                "config": {
                  "label": "Composition: Main Image (large, right)",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "composition_card_image": {
                "type": "Image",
                "config": {
                  "label": "Composition: Card Image (top right)",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "composition_small_image": {
                "type": "Image",
                "config": {
                  "label": "Composition: Small Image (bottom left)",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "tags_section1_title": {
                "type": "Text",
                "config": {
                  "label": "Tag Section 1 Title (optional)",
                  "placeholder": "e.g., Dimensions"
                }
              },
              "tags_section1": {
                "type": "Text",
                "config": {
                  "label": "Tag Section 1 Tags (semicolon-separated)",
                  "placeholder": "Tag1; Tag2; Tag3"
                }
              },
              "tags_section2_title": {
                "type": "Text",
                "config": {
                  "label": "Tag Section 2 Title (optional)",
                  "placeholder": "e.g., Requirements"
                }
              },
              "tags_section2": {
                "type": "Text",
                "config": {
                  "label": "Tag Section 2 Tags (semicolon-separated)",
                  "placeholder": "Tag1; Tag2; Tag3"
                }
              },
              "tags_section3_title": {
                "type": "Text",
                "config": {
                  "label": "Tag Section 3 Title (optional)",
                  "placeholder": "e.g., Notes"
                }
              },
              "tags_section3": {
                "type": "Text",
                "config": {
                  "label": "Tag Section 3 Tags (semicolon-separated)",
                  "placeholder": "Tag1; Tag2; Tag3"
                }
              }
            }
          }
        }
      },
      "items": {
        "card_id": {
          "type": "Text",
          "config": {
            "label": "Card ID (unique identifier)",
            "placeholder": "e.g., accessibility"
          }
        },
        "card_image": {
          "type": "Image",
          "config": {
            "label": "Card Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "card_title": {
          "type": "Text",
          "config": {
            "label": "Card Title",
            "placeholder": "Accessibility (PMR)"
          }
        },
        "application_text": {
          "type": "Text",
          "config": {
            "label": "Application Text",
            "placeholder": "Detect accessibility non-compliances early, before permits or construction."
          }
        },
        "documents_text": {
          "type": "Text",
          "config": {
            "label": "Documents Analysed Text",
            "placeholder": "Plans (PDF), technical notices, regulations."
          }
        },
        "is_selected": {
          "type": "Boolean",
          "config": {
            "label": "Is Selected (First Card)",
            "default_value": false,
            "placeholder_false": "Normal",
            "placeholder_true": "Selected"
          }
        },
        "coming_soon": {
          "type": "Boolean",
          "config": {
            "label": "Coming Soon Badge",
            "default_value": false,
            "placeholder_false": "Available",
            "placeholder_true": "Coming Soon"
          }
        },
        "detail_title": {
          "type": "Text",
          "config": {
            "label": "Detail Section Title",
            "placeholder": "Accessibility (PMR) Compliance Check"
          }
        },
        "detail_description": {
          "type": "Text",
          "config": {
            "label": "Detail Section Description",
            "placeholder": "Ensure that architectural layouts comply with accessibility requirements..."
          }
        }
      }
    }
  ]
}
