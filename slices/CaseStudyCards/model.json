{
  "id": "case_study_cards",
  "type": "SharedSlice",
  "name": "CaseStudyCards",
  "description": "Case study cards with expandable content sections",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Cards grid for case studies with hero and details sections",
      "imageUrl": "",
      "primary": {
        "section_title": {
          "type": "Text",
          "config": {
            "label": "Section Title",
            "placeholder": "Case Study"
          }
        },
        "cards": {
          "type": "Group",
          "config": {
            "label": "Case Study Cards",
            "fields": {
              "image": {
                "type": "Image",
                "config": {
                  "label": "Card Image"
                }
              },
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label",
                  "placeholder": "Cohabs or Coming soon"
                }
              },
              "show_details": {
                "type": "Boolean",
                "config": {
                  "label": "Show Details Section",
                  "default_value": false,
                  "placeholder_false": "Hide details",
                  "placeholder_true": "Show details"
                }
              },
              "application_description": {
                "type": "Text",
                "config": {
                  "label": "Application Description",
                  "placeholder": "Freeda helps..."
                }
              },
              "document_tags": {
                "type": "Group",
                "config": {
                  "label": "Document Tags",
                  "fields": {
                    "icon_type": {
                      "type": "Select",
                      "config": {
                        "label": "Icon Type",
                        "options": [
                          "edit",
                          "lock",
                          "file",
                          "check"
                        ],
                        "default_value": "edit"
                      }
                    },
                    "tag_text": {
                      "type": "Text",
                      "config": {
                        "label": "Tag Text",
                        "placeholder": "Plans"
                      }
                    }
                  }
                }
              },
              "logo": {
                "type": "Image",
                "config": {
                  "label": "Hero Logo",
                  "constraint": {
                    "width": 200,
                    "height": 100
                  }
                }
              },
              "hero_heading": {
                "type": "StructuredText",
                "config": {
                  "label": "Hero Heading",
                  "single": "heading1",
                  "placeholder": "Automating Plan Verification with Cohabs"
                }
              },
              "hero_description": {
                "type": "StructuredText",
                "config": {
                  "label": "Hero Description",
                  "single": "paragraph",
                  "placeholder": "Ensure that architectural layouts comply..."
                }
              },
              "background_image": {
                "type": "Image",
                "config": {
                  "label": "Background Image",
                  "constraint": {
                    "width": 524,
                    "height": 656
                  }
                }
              },
              "foreground_image": {
                "type": "Image",
                "config": {
                  "label": "Foreground Image",
                  "constraint": {
                    "width": 425,
                    "height": 528
                  }
                }
              },
              "show_metrics": {
                "type": "Boolean",
                "config": {
                  "label": "Show Metrics Card",
                  "default_value": false,
                  "placeholder_false": "Hide metrics",
                  "placeholder_true": "Show metrics"
                }
              },
              "annual_roi": {
                "type": "Text",
                "config": {
                  "label": "Annual ROI",
                  "placeholder": "×37"
                }
              },
              "productivity_gains": {
                "type": "Text",
                "config": {
                  "label": "Productivity Gains",
                  "placeholder": "23 hours saved per month"
                }
              },
              "cities": {
                "type": "Text",
                "config": {
                  "label": "Cities",
                  "placeholder": "5"
                }
              },
              "content_title": {
                "type": "StructuredText",
                "config": {
                  "label": "Content Title",
                  "single": "heading1",
                  "placeholder": "Automating Plan Verification"
                }
              },
              "content_description": {
                "type": "StructuredText",
                "config": {
                  "label": "Content Description",
                  "single": "paragraph",
                  "placeholder": "Ensure that architectural layouts comply..."
                }
              },
              "content_sections": {
                "type": "Group",
                "config": {
                  "label": "Content Sections",
                  "fields": {
                    "heading": {
                      "type": "StructuredText",
                      "config": {
                        "label": "Section Heading",
                        "single": "heading2",
                        "placeholder": "Understanding Cohabs' challenges"
                      }
                    },
                    "body_text": {
                      "type": "StructuredText",
                      "config": {
                        "label": "Body Text",
                        "multi": "paragraph,strong,em,hyperlink",
                        "placeholder": "Freeda worked closely with..."
                      }
                    },
                    "image": {
                      "type": "Image",
                      "config": {
                        "label": "Section Image",
                        "constraint": {
                          "width": 523,
                          "height": 560
                        }
                      }
                    },
                    "image_position": {
                      "type": "Select",
                      "config": {
                        "label": "Image Position",
                        "options": [
                          "left",
                          "right"
                        ],
                        "default_value": "left"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}