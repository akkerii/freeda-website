{
  "id": "case_study_content",
  "type": "SharedSlice",
  "name": "CaseStudyContent",
  "description": "Case study content sections with text blocks, images, and videos",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Stacked content sections with headings, paragraphs, images, and videos",
      "imageUrl": "",
      "primary": {
        "sections": {
          "type": "Group",
          "config": {
            "label": "Content Sections",
            "fields": {
              "section_type": {
                "type": "Select",
                "config": {
                  "label": "Section Type",
                  "options": ["text_with_heading", "text_only", "image", "video"],
                  "default_value": "text_with_heading"
                }
              },
              "heading": {
                "type": "Text",
                "config": {
                  "label": "Heading",
                  "placeholder": "Understanding Cohabs' challenges"
                }
              },
              "body_text": {
                "type": "StructuredText",
                "config": {
                  "label": "Body Text",
                  "multi": "paragraph, strong, em, hyperlink",
                  "placeholder": "Freeda worked closely with multiple Cohabs teams..."
                }
              },
              "image": {
                "type": "Image",
                "config": {
                  "label": "Section Image",
                  "constraint": {
                    "width": 880,
                    "height": 560
                  }
                }
              },
              "video_url": {
                "type": "Text",
                "config": {
                  "label": "Video URL",
                  "placeholder": "https://www.youtube.com/watch?v=... or https://vimeo.com/..."
                }
              },
              "video_thumbnail": {
                "type": "Image",
                "config": {
                  "label": "Video Thumbnail (optional)",
                  "constraint": {
                    "width": 880,
                    "height": 560
                  }
                }
              },
              "video_company_logo": {
                "type": "Image",
                "config": {
                  "label": "Company Logo (for video badge)",
                  "constraint": {
                    "width": 200,
                    "height": 60
                  }
                }
              },
              "video_company_name": {
                "type": "Text",
                "config": {
                  "label": "Company Name (for video badge)",
                  "placeholder": "COHABS"
                }
              }
            }
          }
        }
      }
    }
  ]
}
