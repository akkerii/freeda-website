{
  "id": "case_study_hero",
  "type": "SharedSlice",
  "name": "CaseStudyHero",
  "description": "Case study hero section with logo, title, images and metrics",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Hero with overlapping images and metrics card",
      "imageUrl": "",
      "primary": {
        "badge_text": {
          "type": "Text",
          "config": {
            "label": "Badge Text",
            "placeholder": "Uses cases"
          }
        },
        "counter_number": {
          "type": "Text",
          "config": {
            "label": "Counter Number",
            "placeholder": "1345"
          }
        },
        "logo": {
          "type": "Image",
          "config": {
            "label": "Logo Image",
            "constraint": {
              "width": 200,
              "height": 100
            }
          }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "single": "heading1",
            "placeholder": "Automating Plan Verification with Cohabs"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Description",
            "single": "paragraph",
            "placeholder": "Ensure that architectural layouts comply..."
          }
        },
        "background_image": {
          "type": "Image",
          "config": {
            "label": "Background Image",
            "constraint": {
              "width": 524,
              "height": 656
            }
          }
        },
        "foreground_image": {
          "type": "Image",
          "config": {
            "label": "Foreground Image",
            "constraint": {
              "width": 425,
              "height": 528
            }
          }
        },
        "show_metrics": {
          "type": "Boolean",
          "config": {
            "label": "Show Metrics Card",
            "default_value": false,
            "placeholder_false": "Hide metrics",
            "placeholder_true": "Show metrics"
          }
        },
        "annual_roi": {
          "type": "Text",
          "config": {
            "label": "Annual ROI",
            "placeholder": "×37"
          }
        },
        "productivity_gains": {
          "type": "Text",
          "config": {
            "label": "Productivity Gains",
            "placeholder": "23 hours saved per month"
          }
        },
        "cities": {
          "type": "Text",
          "config": {
            "label": "Cities",
            "placeholder": "5"
          }
        }
      }
    }
